# Copy to .env (or run `pnpm setup:env` at the repo root) to run this service or its migrations on the host.
PORT=3001
DATABASE_URL=postgresql://identity:identity@localhost:5432/identity_db
RABBITMQ_URL=amqp://tms:tms_dev@localhost:5672
FIREBASE_PROJECT_ID=private-tutor-management-sys
GOOGLE_APPLICATION_CREDENTIALS=../../infra/keys/firebase-service-account.json
# Set to use the Firebase Auth emulator instead of the real project:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Used to build invitation links (acceptUrl) until Notification exists:
# FRONTEND_URL=http://localhost:5173
# class-service, asked before disabling a Tutor (BR-CL-08). Unset = check stubbed.
CLASS_SERVICE_URL=http://localhost:3003
