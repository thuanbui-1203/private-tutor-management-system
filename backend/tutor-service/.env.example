# Copy to .env (or run `pnpm setup:env` at the repo root) to run this service or its migrations on the host.
PORT=3009
DATABASE_URL=postgresql://tutor:tutor@localhost:5432/tutor_db
RABBITMQ_URL=amqp://tms:tms_dev@localhost:5672
# Files (docs/07 §5): the Realtime Database emulator from `pnpm emulators`.
FIREBASE_PROJECT_ID=demo-tms
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9002
FIREBASE_DATABASE_URL=http://127.0.0.1:9002?ns=demo-tms-default-rtdb
# 32 random bytes, base64: encrypts stored files. `pnpm setup:env` fills it in.
FILE_DATA_KEY=
