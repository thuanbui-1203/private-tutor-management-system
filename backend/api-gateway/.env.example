# Copy to .env (or run `pnpm setup:env` at the repo root) to run the gateway on the host.
PORT=8080
REDIS_URL=redis://localhost:6379
FIREBASE_PROJECT_ID=private-tutor-management-sys
GOOGLE_APPLICATION_CREDENTIALS=../../infra/keys/firebase-service-account.json
# Set to use the Firebase Auth emulator instead of the real project:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Where each service listens (defaults are the docker compose service names):
IDENTITY_SERVICE_URL=http://localhost:3001
STUDENT_SERVICE_URL=http://localhost:3002
CLASS_SERVICE_URL=http://localhost:3003
SCHEDULE_SERVICE_URL=http://localhost:3004
BILLING_SERVICE_URL=http://localhost:3006
# Comma-separated origins allowed by CORS, and per-minute rate limits:
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_IP_PER_MINUTE=600
RATE_LIMIT_USER_PER_MINUTE=300
