{
  "name": "@tms/common",
  "version": "0.1.0",
  "private": true,
  "description": "Shared plumbing for TMS services: outbox, RabbitMQ consumers, auth guard, health, metrics, logging, internal HTTP client",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --testPathIgnorePatterns=\\.int\\.spec\\.ts$",
    "test:int": "jest --testRegex=\\.int\\.spec\\.ts$ --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@tms/contracts": "workspace:*",
    "amqplib": "catalog:",
    "prom-client": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/platform-express": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/express": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "jest": "catalog:",
    "pg": "catalog:",
    "supertest": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testRegex": "\\.spec\\.ts$"
  }
}
