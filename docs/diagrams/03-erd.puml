@startuml 03-erd
' ERD - Database per Service
' Đường liền: khóa ngoại (FK) thật trong cùng DB
' Đường nét đứt: tham chiếu logic giữa các service (KHÔNG có FK, đồng bộ qua event)
' Bỏ dòng pragma nếu máy đã cài Graphviz
!pragma layout smetana
title ERD - Tutor Management System (Database per Service)
hide circle
hide methods
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #3A6EA5
  HeaderBackgroundColor #E3EEFA
}
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #999999
}

package "identity_db" #F5F9FF {
  entity users {
    * id : UUID <<PK>>
    --
    * firebase_uid : VARCHAR(128) <<UNIQUE>>
    * email : VARCHAR(255) <<UNIQUE>>
    <i>(mật khẩu nằm ở Firebase Auth, ADR-0004)</i>
    * role : ENUM(ADMIN, TUTOR, PARENT, STUDENT)
    * status : ENUM(PENDING, ACTIVE, DISABLED)
    created_at : TIMESTAMP
  }
  entity invitations {
    * id : UUID <<PK>>
    --
    * user_id : UUID <<FK>>
    * token_hash : TEXT <<UNIQUE>> (SHA-256)
    * invited_by : UUID <<ref users>>
    * expires_at : TIMESTAMP (+7 ngày)
    used_at : TIMESTAMP
    revoked_at : TIMESTAMP
    created_at : TIMESTAMP
    <i>(dùng 1 lần; gửi lại thì thu hồi bản cũ)</i>
  }
  users ||--o{ invitations
}

package "student_db" #F5FFF5 {
  entity parents {
    * id : UUID <<PK>>
    --
    user_id : UUID <<ref users>> (không unique)
    * full_name : VARCHAR(100)
    * phone : VARCHAR(20)
    email : VARCHAR(255)
    * created_by : UUID <<ref users>>
  }
  entity students {
    * id : UUID <<PK>>
    --
    * tutor_id : UUID <<ref users>>
    user_id : UUID <<ref users>>
    * full_name : VARCHAR(100)
    email : VARCHAR(255)
    * dob : DATE
    school : VARCHAR(150)
    grade : SMALLINT
    note : TEXT (chỉ TUTOR / ADMIN xem)
    * payer : ENUM(PRIMARY_PARENT, SELF)
    * status : ENUM(ACTIVE, PAUSED, GRADUATED, DROPPED)
    anonymised_at : TIMESTAMP
    ..
    CHECK: dưới 18 tuổi -> payer = PRIMARY_PARENT
  }
  entity student_parents {
    * student_id : UUID <<PK, FK>>
    * parent_id : UUID <<PK, FK>>
    --
    * is_primary : BOOLEAN
    ..
    Đúng 1 dòng is_primary = true / học sinh
  }
  students ||--o{ student_parents
  parents ||--o{ student_parents
}

package "class_db" #FFFDF0 {
  entity classes {
    * id : UUID <<PK>>
    --
    * tutor_id : UUID <<ref users>>
    * name : VARCHAR(100)
    * subject : VARCHAR(50)
    * type : ENUM(ONE_ON_ONE, GROUP)
    max_students : SMALLINT
    * fee_type : ENUM(PER_SESSION, MONTHLY)
    * fee_amount : DECIMAL(12,0)
    * charge_absent : BOOLEAN (mặc định true)
    * status : ENUM(OPEN, CLOSED)
  }
  entity enrollments {
    * id : UUID <<PK>>
    --
    * class_id : UUID <<FK>>
    * student_id : UUID <<ref students>>
    * status : ENUM(PENDING, AWAITING_PAYMENT, ACTIVE,
 PAUSED, WITHDRAWN, REJECTED)
    payment_deadline : TIMESTAMP (+7 ngày, chỉ MONTHLY)
    roster_confirmed_at : TIMESTAMP
    withdraw_reason : ENUM(REQUESTED, UNPAID,
 CLASS_CLOSED, STUDENT_STATUS, SYNC_FAILED)
    joined_at : DATE
    left_at : DATE
    ..
    UNIQUE(class_id, student_id)
  }
  classes ||--o{ enrollments
}

package "schedule_db" #FFF5F5 {
  entity schedules {
    * id : UUID <<PK>>
    --
    * class_id : UUID <<ref classes>>
    * weekday : SMALLINT (1-7)
    * start_time : TIME
    * end_time : TIME
    * from_date : DATE
    to_date : DATE
  }
  entity sessions {
    * id : UUID <<PK>>
    --
    schedule_id : UUID <<FK>>
    * class_id : UUID <<ref classes>>
    * tutor_id : UUID <<ref users>>
    * date : DATE
    * start_time : TIME
    * end_time : TIME
    * status : ENUM(SCHEDULED, IN_PROGRESS, COMPLETED,
 CANCELLED, RESCHEDULED, MISSED)
    makeup_of : UUID <<FK sessions>>
  }
  entity attendances {
    * session_id : UUID <<PK, FK>>
    * student_id : UUID <<PK, ref students>>
    --
    * status : ENUM(PRESENT, LATE, EXCUSED, ABSENT)
    note : VARCHAR(255)
    recorded_at : TIMESTAMP
  }
  entity class_roster_view {
    * class_id : UUID <<PK>>
    * student_id : UUID <<PK>>
    --
    * enrollment_id : UUID <<ref enrollments>>
    student_name : VARCHAR(100)
    joined_at : DATE
    left_at : DATE
    <i>(bản sao từ StudentEnrolled / StudentWithdrawn)</i>
  }
  schedules ||--o{ sessions
  sessions ||--o{ attendances
  sessions |o--o| sessions : makeup_of
}

package "academic_db (MongoDB)" #F8F5FF {
  entity assignments {
    * _id : ObjectId <<PK>>
    --
    * class_id : UUID <<ref classes>>
    * title : String
    description : String
    * due_date : Date
    attachments : [String]
  }
  entity grades {
    * _id : ObjectId <<PK>>
    --
    * student_id : UUID <<ref students>>
    * class_id : UUID <<ref classes>>
    assignment_id : ObjectId <<FK>>
    * type : ENUM(HOMEWORK, QUIZ, TEST)
    * score : Decimal (0-10)
    * date : Date
  }
  entity feedbacks {
    * _id : ObjectId <<PK>>
    --
    * session_id : UUID <<ref sessions>>
    * student_id : UUID <<ref students>>
    * content : String
    rating : Int (1-5)
  }
  assignments ||--o{ grades
}

package "billing_db" #FFF8EE {
  entity fee_policies {
    * class_id : UUID <<PK, ref classes>>
    * effective_from : CHAR(7) <<PK>> (YYYY-MM)
    --
    * tutor_id : UUID <<ref users>>
    * fee_type : ENUM(PER_SESSION, MONTHLY)
    * fee_amount : DECIMAL(12,0)
    * charge_absent : BOOLEAN
    <i>(bản sao từ ClassCreated/Updated; giữ lịch sử,</i>
    <i>kỳ P dùng dòng có effective_from <= P mới nhất)</i>
  }
  entity student_snapshots {
    * student_id : UUID <<PK, ref students>>
    --
    * tutor_id : UUID <<ref users>>
    * full_name : VARCHAR(100)
    * payer_contact : JSONB
    * status : ENUM(ACTIVE, PAUSED, GRADUATED, DROPPED)
    <i>(bản sao từ StudentCreated/Updated/StatusChanged)</i>
  }
  entity enrollment_copies {
    * enrollment_id : UUID <<PK, ref enrollments>>
    --
    * class_id : UUID <<ref classes>>
    * student_id : UUID <<ref students>>
    * fee_type : ENUM(PER_SESSION, MONTHLY)
    * joined_at : DATE
    left_at : DATE
    <i>(bản sao từ StudentEnrolled / StudentWithdrawn)</i>
  }
  entity session_calendar {
    * session_id : UUID <<PK, ref sessions>>
    --
    * class_id : UUID <<ref classes>>
    * date : DATE
    * status : ENUM(SCHEDULED, CANCELLED, RESCHEDULED)
    <i>(bản sao từ SessionScheduled / Cancelled / Rescheduled,</i>
    <i>dùng tính tỉ lệ phí MONTHLY theo số buổi)</i>
  }
  entity invoices {
    * id : UUID <<PK>>
    --
    * kind : ENUM(MONTHLY, ENROLLMENT)
    * student_id : UUID <<ref students>>
    * tutor_id : UUID <<ref users>>
    enrollment_id : UUID <<ref enrollments>> (chỉ ENROLLMENT)
    * student_name_snapshot : VARCHAR(100)
    * payer_contact_snapshot : VARCHAR(255)
    * period : CHAR(7) (YYYY-MM)
    * total : DECIMAL(12,0)
    * status : ENUM(DRAFT, ISSUED, PARTIALLY_PAID, PAID, OVERDUE, VOID)
    issued_at : TIMESTAMP
    due_date : DATE
    replaces_invoice_id : UUID <<FK invoices>>
    void_reason : VARCHAR(500)
    ..
    UNIQUE(student_id, period) WHERE kind = MONTHLY
     AND status <> VOID
    status suy ra từ payments (ADR-0002)
  }
  entity invoice_items {
    * id : UUID <<PK>>
    --
    * invoice_id : UUID <<FK>>
    * type : ENUM(FEE, ADJUSTMENT)
    * student_id : UUID <<ref students>>
    * tutor_id : UUID <<ref users>>
    class_id : UUID <<ref classes>> (null: số dư chuyển kỳ)
    session_id : UUID <<ref sessions>>
    enrollment_id : UUID <<ref enrollments>>
    adjusts_item_id : UUID <<FK invoice_items>>
    * service_period : CHAR(7) (tháng của khoản phí)
    attendance_status : ENUM(PRESENT, LATE, EXCUSED, ABSENT)
    * description : VARCHAR(255)
    * amount : DECIMAL(12,0) (ADJUSTMENT có thể âm)
    * superseded : BOOLEAN (đã chép sang hóa đơn thay thế)
    ..
    UNIQUE(session_id, student_id) WHERE type = FEE AND NOT superseded
    UNIQUE(enrollment_id, service_period) WHERE type = FEE AND NOT superseded
  }
  entity payments {
    * id : UUID <<PK>>
    --
    * invoice_id : UUID <<FK>>
    * kind : ENUM(PAYMENT, REVERSAL)
    reverses_payment_id : UUID <<FK payments>>
    * amount : DECIMAL(12,0)
    * method : ENUM(CASH, BANK_TRANSFER, MOMO)
    * paid_at : TIMESTAMP
    * recorded_by : UUID <<ref users>>
    ..
    Chỉ INSERT; tổng PAYMENT - REVERSAL <= total
  }
  entity period_closes {
    * period : CHAR(7) <<PK>>
    --
    * closed_at : TIMESTAMP
    <i>(tháng đã chốt: không mở hóa đơn nháp mới)</i>
  }
  entity invoice_reminders {
    * invoice_id : UUID <<PK, FK invoices>>
    * days_overdue : SMALLINT <<PK>> (1, 5, 10)
    --
    * sent_at : TIMESTAMP
  }
  entity processed_events {
    * event_id : UUID <<PK>>
    --
    processed_at : TIMESTAMP
    <i>(chống xử lý trùng - idempotency)</i>
  }
  invoices ||--|{ invoice_items
  invoices ||--o{ payments
  invoice_items |o--o| invoice_items : adjusts_item_id
  payments |o--o| payments : reverses_payment_id
}

package "notification_db" #F0FAFA {
  entity notifications {
    * id : UUID <<PK>>
    --
    * recipient : VARCHAR(255)
    * channel : ENUM(EMAIL, SMS, ZALO)
    * template : VARCHAR(50)
    payload : JSONB
    * status : ENUM(PENDING, SENT, FAILED)
    retry_count : SMALLINT
    sent_at : TIMESTAMP
  }
}

note as OutboxNote
  Mỗi service phát event đều có thêm bảng
  **outbox_events**(id = eventId, event_type, routing_key,
  payload JSONB, created_at, published_at)
  ghi chung transaction với dữ liệu nghiệp vụ,
  và mỗi service nhận event có **processed_events**(event_id)
  (DDL: packages/common/sql/messaging.sql).
end note

' --- Tham chiếu logic giữa các service (không FK)
users .. students : tutor_id / user_id
users .. parents : user_id
students .. enrollments : student_id
enrollments .. invoices : enrollment_id
classes .. schedules : class_id
classes .. fee_policies : class_id
students .. attendances : student_id
sessions .. invoice_items : session_id
sessions .. session_calendar : session_id
students .. invoices : student_id
sessions .. feedbacks : session_id

@enduml
