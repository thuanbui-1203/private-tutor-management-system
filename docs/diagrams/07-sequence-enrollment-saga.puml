@startuml 07-sequence-enrollment-saga
' Sequence diagram - Ghi danh học sinh vào lớp (Saga choreography)
' Liên quan: BR-CL-06, BR-CL-07, BR-BI-06, BR-NO-01, ADR-0002
title Sequence Diagram - Ghi danh học sinh vào lớp (Saga)
autonumber
skinparam responseMessageBelowArrow true

actor "Giáo viên" as U
participant "API Gateway" as GW
participant "Class Service" as Cl
database "class_db" as ClDB
participant "Student Service" as St
queue "RabbitMQ" as MQ
participant "Schedule & Attendance" as Sc
participant "Billing Service" as Bi
participant "Notification Service\n<i>(tùy chọn, BR-SYS-03)</i>" as No

== 1. Tạo ghi danh (đồng bộ) ==
U -> GW : POST /classes/{classId}/enrollments\n{studentId}
GW -> Cl : forward (X-User-Id)

Cl -> ClDB : Kiểm tra lớp thuộc tutor, OPEN,\nchỗ trống (PENDING + AWAITING_PAYMENT\n+ ACTIVE < max_students), chưa ghi danh
alt Lớp không hợp lệ / đầy
  Cl --> GW : 409 Conflict
  GW --> U : Báo lỗi
else Hợp lệ
  Cl -> St : GET /internal/students/{studentId}
  note right of St : timeout 2s + retry 2 lần\n+ circuit breaker
  alt Học sinh không tồn tại / không thuộc tutor
    St --> Cl : 404
    Cl --> GW : 422 Unprocessable
    GW --> U : "Học sinh không hợp lệ"
  else Student Service không phản hồi (circuit OPEN)
    Cl -> ClDB : INSERT enrollment (status = PENDING)\n<i>giữ chỗ</i>
    Cl --> GW : 202 Accepted (chờ xác nhận)
    GW --> U : "Đang xử lý ghi danh"
    ... Student Service hoạt động lại, job đối soát chạy ...
    Cl -> St : GET /internal/students/{studentId}
    St --> Cl : 200
    Cl -> ClDB : UPDATE enrollment = ACTIVE / AWAITING_PAYMENT\n(theo fee_type, như bên dưới)\n+ INSERT outbox StudentEnrolled
  else Hợp lệ
    St --> Cl : 200 {id, fullName, payerContact}
    Cl -> ClDB : BEGIN
    alt fee_type = PER_SESSION
      Cl -> ClDB : INSERT enrollment (ACTIVE)
    else fee_type = MONTHLY
      Cl -> ClDB : INSERT enrollment (AWAITING_PAYMENT,\npayment_deadline = now + 7 ngày)
    end
    Cl -> ClDB : INSERT outbox StudentEnrolled\nCOMMIT
    Cl --> GW : 201 Created {status}
    GW --> U : "Đã ghi danh"
  end
end

== 2. Lan truyền event (bất đồng bộ) ==
Cl -> MQ : publish StudentEnrolled\n{enrollmentId, classId, studentId,\nstudentName, feeType, status, joinedAt}
par Schedule: đưa vào roster
  MQ -> Sc : StudentEnrolled
  Sc -> Sc : Thêm vào class_roster_view\n(các buổi sắp tới)
  alt Thành công
    Sc -> MQ : publish EnrollmentConfirmed\n{enrollmentId, classId, studentId}
    MQ -> Cl : EnrollmentConfirmed
    Cl -> ClDB : SET roster_confirmed_at
    MQ -> No : EnrollmentConfirmed
    No -> No : Gửi email chào mừng + lịch học\n(BR-NO-01: chỉ sau khi roster xác nhận)
  else Lỗi xử lý
    Sc -> MQ : publish EnrollmentSyncFailed
    MQ -> Cl : EnrollmentSyncFailed
    Cl -> Cl : Bù trừ: enrollment = REJECTED\n(nhả chỗ) + publish StudentWithdrawn\n(reason = SYNC_FAILED)
  end
else Billing: hóa đơn ghi danh (chỉ MONTHLY)
  MQ -> Bi : StudentEnrolled
  Bi -> Bi : Lưu snapshot tên / liên hệ Payer
  opt feeType = MONTHLY
    Bi -> Bi : Đếm buổi trong session_calendar (bản sao cục bộ):\nsố buổi từ joinedAt đến cuối tháng / số buổi cả tháng
    Bi -> Bi : Tạo invoice kind = ENROLLMENT, ISSUED ngay\nphí tháng đầu theo tỉ lệ (BR-BI-06)\ndue_date = now + 7 ngày
    Bi -> MQ : publish InvoiceIssued {kind = ENROLLMENT}
    MQ -> No : InvoiceIssued
    No -> No : Gửi hóa đơn ghi danh cho Payer
  end
end

== 3a. Thanh toán hóa đơn ghi danh (MONTHLY) ==
U -> GW : POST /billing/invoices/{id}/payments
GW -> Bi : forward
Bi -> Bi : INSERT payment (không vượt số còn nợ, BR-BI-07)\nstatus suy ra = PAID
Bi -> MQ : publish PaymentReceived\n{invoiceId, invoiceKind, enrollmentId,\namount, invoiceStatus = PAID}
MQ -> Cl : PaymentReceived [invoiceKind = ENROLLMENT\nvà invoiceStatus = PAID]
Cl -> ClDB : enrollment AWAITING_PAYMENT -> ACTIVE

== 3b. Quá hạn chưa thanh toán (BR-CL-07) ==
Cl -> Cl : Cron hằng ngày: AWAITING_PAYMENT\nvà payment_deadline < now
Cl -> ClDB : enrollment = WITHDRAWN\n(withdraw_reason = UNPAID), nhả chỗ\n+ INSERT outbox StudentWithdrawn
Cl -> MQ : publish StudentWithdrawn {reason = UNPAID}
par
  MQ -> Sc : StudentWithdrawn
  Sc -> Sc : Gỡ khỏi roster các buổi tương lai
else
  MQ -> Bi : StudentWithdrawn
  Bi -> Bi : Không xóa / sửa hóa đơn ghi danh (ADR-0002);\nphần tính thừa theo tỉ lệ -> Adjustment\nở hóa đơn kế tiếp (BR-BI-05)
end

@enduml
