{
  "name": "tutor-management-system",
  "private": true,
  "description": "Tutor Management System: microservices monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:int": "pnpm -r --workspace-concurrency=1 --if-present test:int",
    "lint": "eslint . && pnpm --filter @tms/frontend lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:all": "pnpm -r --if-present migrate:deploy",
    "setup:env": "node scripts/setup-env.mjs",
    "compose": "node scripts/compose.mjs",
    "emulators": "firebase emulators:start --only auth --project demo-tms",
    "seed": "pnpm -r --if-present seed",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:host": "node scripts/e2e-host.mjs",
    "test:e2e:down": "docker compose -p tms-e2e -f docker-compose.yml -f docker-compose.e2e.yml down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.44.1"
  }
}
