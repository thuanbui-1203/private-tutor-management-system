{
  "name": "tutor-management-system",
  "private": true,
  "description": "Tutor Management System: microservices monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . && pnpm --filter @tms/frontend lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:all": "pnpm -r --if-present migrate:deploy",
    "setup:env": "node scripts/setup-env.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.44.1"
  }
}
