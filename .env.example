# Copy to .env (or run `pnpm setup:env`). Used by docker compose; values are for local development.
# Never commit .env.

# ---------- General ----------
NODE_ENV=development
LOG_LEVEL=debug
TZ=Asia/Ho_Chi_Minh

# ---------- Infrastructure ----------
POSTGRES_USER=tms
POSTGRES_PASSWORD=tms_secret
RABBITMQ_URL=amqp://tms:tms_dev@rabbitmq:5672
REDIS_URL=redis://redis:6379

# ---------- One database per service (ADR-0003); roles come from infra/postgres/init.sql ----------
IDENTITY_DB_URL=postgresql://identity:identity@postgres:5432/identity_db
STUDENT_DB_URL=postgresql://student:student@postgres:5432/student_db
CLASS_DB_URL=postgresql://class:class@postgres:5432/class_db
SCHEDULE_DB_URL=postgresql://schedule:schedule@postgres:5432/schedule_db
BILLING_DB_URL=postgresql://billing:billing@postgres:5432/billing_db
AUDIT_DB_URL=postgresql://audit:audit@postgres:5432/audit_db

# ---------- Firebase Authentication (ADR-0004) ----------
# Server side (gateway, identity-service): service account key mounted from infra/keys/.
FIREBASE_PROJECT_ID=private-tutor-management-sys
GOOGLE_APPLICATION_CREDENTIALS=/run/keys/firebase-service-account.json
# Uncomment to point the gateway and identity-service at the Firebase Auth emulator
# (`firebase emulators:start --only auth`) instead of the real project:
# FIREBASE_AUTH_EMULATOR_HOST=host.docker.internal:9099
# Web app config (public), baked into the frontend image at build time.
# `pnpm setup:env` copies these from frontend/.env.local when it exists.
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=private-tutor-management-sys.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=private-tutor-management-sys
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Business defaults ----------
BILLING_INVOICE_DUE_DAY=10
BILLING_CHARGE_ABSENT=true
# VietQR transfer target: bank BIN (NAPAS, e.g. 970436), account number, account holder.
# Leave empty and GET /billing/invoices/{id}/qr answers 503.
BILLING_BANK_BIN=
BILLING_BANK_ACCOUNT=
BILLING_BANK_ACCOUNT_NAME=
# 32 random bytes, base64: encrypts bank account numbers stored with consent (ADR-0006).
# `pnpm setup:env` fills it in. Keep it secret and never change it once accounts are stored
# (they could no longer be decrypted). Empty = bank details cannot be stored (503).
BANK_DATA_KEY=
ATTENDANCE_EDIT_WINDOW_HOURS=48
# Paying Tutors (docs/07 §6). `sandbox` simulates the bank and moves no real money; refused with
# NODE_ENV=production. Empty = payrolls can be prepared but not paid. With it on, tuition QR codes
# point only to the centre's account (BILLING_BANK_*), never to a Tutor's.
PAYOUT_MODE=sandbox
# Signs the payment notices; `pnpm setup:env` fills it in.
PAYOUT_WEBHOOK_SECRET=
# Where the payroll QR leads. To scan it with a phone, use this computer's LAN address
# (http://192.168.x.x:5173) here and in NEXT_PUBLIC_API_URL / CORS_ORIGINS.
SANDBOX_PUBLIC_URL=http://localhost:5173
# Access records older than this are purged by audit-service (ADR-0005).
AUDIT_RETENTION_DAYS=365

# ---------- Mail: activation emails from identity-service ----------
# Dev: Mailpit catches every email (http://localhost:8025). For real delivery see
# .env.production.example (Gmail + App Password).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TMS <no-reply@tms.local>"

# ---------- Monitoring: Prometheus + Grafana (docs/03-cach-chay.md §8) ----------
# Grafana login. CHANGE the password on any machine other than your laptop.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Host address/port Grafana listens on. 127.0.0.1 = only this machine (reverse proxy or
# SSH tunnel on a VPS); 0.0.0.0 = every interface (open the port in the firewall yourself).
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
# Behind a reverse proxy on a sub-path: GRAFANA_ROOT_URL=https://tms.example.com/grafana/
# and GRAFANA_SERVE_FROM_SUB_PATH=true.
GRAFANA_ROOT_URL=http://localhost:3000/
GRAFANA_SERVE_FROM_SUB_PATH=false
PROMETHEUS_RETENTION=15d

# ---------- Watching the VPS from this laptop (docker-compose.grafana-vps.yml) ----------
# IP of the VPS (see ~/.ssh/config, Host tms-vps). Kept here, not in the repo.
TMS_VPS_HOST=
