# VPS (production) settings: copy to .env on the server and fill in every <...>.
# Used with: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# Full steps: docs/06-trien-khai-vps.md. Never commit .env.

# ---------- Public addresses (Cloudflare Tunnel) ----------
# DOMAIN is the domain on Cloudflare; the app lives on app.<DOMAIN>, the API on api.<DOMAIN>.
FRONTEND_URL=https://app.<DOMAIN>
CORS_ORIGINS=https://app.<DOMAIN>
# Baked into the frontend image at build time: rebuild the frontend after changing it.
NEXT_PUBLIC_API_URL=https://api.<DOMAIN>/api
# cloudflared reaches the gateway over the Docker network (a private address), so trust
# X-Forwarded-For from private ranges: rate limiting then counts per real client IP.
TRUST_PROXY=uniquelocal
RATE_LIMIT_IP_PER_MINUTE=600
RATE_LIMIT_USER_PER_MINUTE=300

# ---------- General ----------
# "development" on purpose for the demo: with "production", POST /invitations hides the
# invitation link, and there is no notification service yet to e-mail it (BR-SYS-03).
# The images still run their production build either way.
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Ho_Chi_Minh

# ---------- Infrastructure (reachable only inside the Docker network) ----------
POSTGRES_USER=tms
# Long random string, e.g. `openssl rand -hex 24`. Only read when the pg-data volume is created.
POSTGRES_PASSWORD=<random>
RABBITMQ_URL=amqp://tms:tms_dev@rabbitmq:5672
REDIS_URL=redis://redis:6379

# Per-service roles come from infra/postgres/init.sql (not published outside Docker).
IDENTITY_DB_URL=postgresql://identity:identity@postgres:5432/identity_db
STUDENT_DB_URL=postgresql://student:student@postgres:5432/student_db
CLASS_DB_URL=postgresql://class:class@postgres:5432/class_db
SCHEDULE_DB_URL=postgresql://schedule:schedule@postgres:5432/schedule_db
BILLING_DB_URL=postgresql://billing:billing@postgres:5432/billing_db
# audit-service (ADR-0005). On a volume created before it existed, run
# infra/postgres/add-audit-db.sql once (docs/06-trien-khai-vps.md).
AUDIT_DB_URL=postgresql://audit:audit@postgres:5432/audit_db
AUDIT_RETENTION_DAYS=365

# ---------- Firebase Authentication ----------
FIREBASE_PROJECT_ID=private-tutor-management-sys
GOOGLE_APPLICATION_CREDENTIALS=/run/keys/firebase-service-account.json
FIREBASE_AUTH_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_API_KEY=<same as local .env>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=private-tutor-management-sys.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=private-tutor-management-sys
NEXT_PUBLIC_FIREBASE_APP_ID=<same as local .env>

# ---------- Mail: activation emails (identity-service) ----------
# Gmail SMTP with an App Password (Google account > Security > 2-Step Verification
# must be on > App passwords). About 500 emails/day; the sender is that Gmail address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<your-gmail-address>
SMTP_PASS=<16-character app password, no spaces>
SMTP_FROM="Tim Gia Su <your-gmail-address>"

# ---------- Business defaults ----------
BILLING_INVOICE_DUE_DAY=10
BILLING_CHARGE_ABSENT=true
BILLING_BANK_BIN=
BILLING_BANK_ACCOUNT=
BILLING_BANK_ACCOUNT_NAME=
# 32 random bytes, base64 (`openssl rand -base64 32`): encrypts bank account numbers stored
# with consent (ADR-0006). Never change it once accounts are stored. Empty = cannot store (503).
BANK_DATA_KEY=<random>
ATTENDANCE_EDIT_WINDOW_HOURS=48

# ---------- Monitoring ----------
# Started only with --profile monitoring. Grafana listens on 127.0.0.1 of the VPS only: ssh -L 3000:127.0.0.1:3000 tms-vps
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<random>
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://localhost:3000/
GRAFANA_SERVE_FROM_SUB_PATH=false
PROMETHEUS_RETENTION=7d
